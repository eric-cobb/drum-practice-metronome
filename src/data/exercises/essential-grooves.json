          { "voices": ["hihat-closed"] }
        ]
      ]
    },
    {
      "id": "half-time-rock",
      "number": 3,
      "name": "Half-Time Rock",
      "sectionId": "rock-pop",
      "timeSignature": { "numerator": 4, "denominator": 4 },
      "subdivision": "8th",
      "notes": "The snare moves from beats 2 and 4 to beat 3 only, halving the perceived backbeat speed. Used in heavier rock, ballads, and any context that wants a slower, more spacious feel even at a brisk tempo.",
      "pattern": [
