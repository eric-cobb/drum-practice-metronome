      "id": "basic-rock-4-4",
      "number": 1,
      "name": "Basic Rock 4/4",
      "sectionId": "rock-pop",
      "timeSignature": { "numerator": 4, "denominator": 4 },
      "subdivision": "8th",
      "notes": "The universal rock groove. Hi-hat on every eighth, kick on beats 1 and 3, snare backbeat on 2 and 4. Foundation for nearly every rock, pop, and country song ever written.",
      "pattern": [
        [
          { "voices": ["hihat-closed", "kick"] },
