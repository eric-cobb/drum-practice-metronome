      "number": 2,
      "name": "Driving Eighths",
      "sectionId": "rock-pop",
      "timeSignature": { "numerator": 4, "denominator": 4 },
      "subdivision": "8th",
      "notes": "Basic rock with an added kick on the 'and of 2' for forward momentum. Common in pop-punk, driving rock, and any context that wants the groove to push rather than sit.",
      "pattern": [
        [
          { "voices": ["hihat-closed", "kick"] },
